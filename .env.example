# ── Base de datos ──────────────────────────────────────────────
# Nube (Render): define DATABASE_URL en Environment del servicio (no en .env)
# TiDB Cloud:   mysql://user:password@host:4006/dbname?ssl-mode=REQUIRED
#   - El SSL se activa con ?ssl-mode=REQUIRED, ssl=true o host tidbcloud.com
# Local (dev sobre MySQL):  mysql://root:password@localhost:3306/SistemaPOSv1_1
# Escritorio OFFLINE:       sqlite:///C:/ruta/pos.db  (datos llegan por pull)
DATABASE_URL="mysql://user:password@host:port/dbname?ssl-mode=REQUIRED"

# ── Sincronización escritorio <-> nube (solo modo sqlite) ──────
# URL de la nube + credenciales de la máquina (usuarios creados desde
# el panel admin con permiso de sync). Si faltan, no hay sincronización.
# CLOUD_URL="https://mi-pos.onrender.com"
# SYNC_USER="sync_tienda1"
# SYNC_PASSWORD="********"
# SYNC_INTERVAL=8           # segundos entre ciclos (default 8)
# MACHINE_ID="CAJA1"        # sufijo VEN-...-CAJA1 / CAJA-...-CAJA1 para
#                           # no chocar numeración entre máquinas (<=6 chars)

# ── IA ─────────────────────────────────────────────────────────
# Google Gemini API Key (free tier): https://aistudio.google.com/apikey
# GEMINI_API_KEY="your_gemini_api_key_here"
# Groq API Key (100% free): https://console.groq.com
# GROQ_API_KEY="your_groq_api_key_here"
# OPENROUTER_API_KEY="your_openrouter_key_here"

# ── Otros ──────────────────────────────────────────────────────
# PORT=5000                  # Render lo inyecta solo
# WAITRESS_THREADS=8         # hilos waitress (default 8)
# DB_POOL_MAX=10             # conexiones MySQL por proceso (default 10)
# TRUSTED_PROXY=127.0.0.1    # confiar X-Forwarded-For de este hop (Render)
# SECRET_KEY="your_secret_key_here"
# DEBUG=True
