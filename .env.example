# Database connection URL (MySQL)
# Local:  mysql://root:password@localhost:3306/SistemaPOSv1_1
# TiDB Cloud (nube/Render): mysql://user:password@host:4006/dbname?ssl-mode=REQUIRED
#   - El SSL se activa con ?ssl-mode=REQUIRED, ssl=true o host tidbcloud.com
#   - Render: define DATABASE_URL en Environment del servicio (no en .env)
DATABASE_URL="mysql://user:password@host:port/dbname?ssl-mode=REQUIRED"

# Google Gemini API Key (free tier)
# Get yours at: https://aistudio.google.com/apikey
# GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key (100% free, no credit card)
# Get yours at: https://console.groq.com
# GROQ_API_KEY="your_groq_api_key_here"

# Flask Secret Key (if needed)
# SECRET_KEY="your_secret_key_here"

# Other environment variables
# PORT=5000
# DEBUG=True
